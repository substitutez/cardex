# CarDex Agent Environment Configuration

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east1
MODEL_NAME=gemini-2.5-flash

# Cloud Storage Bucket for Car Spot Images
GCS_BUCKET=your-bucket-name

# Vertex AI Memory Bank Service URI (Agent Engine ID)
MEMORY_SERVICE_URI=agentengine://<YOUR_AGENT_ENGINE_ID>

# Optional CarAPI Keys (Public fallbacks used if omitted)
# CARAPI_KEY=your-api-key
# CARAPI_SECRET=your-api-secret

# Stripe Monetization (Pro Subscription & Consumable Refill Packs)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
